<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background"
    android:padding="24dp">

    <!-- Deadline notice with improved styling -->
    <TextView
        android:id="@+id/deadlineTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deadline: 10-01-2025, 12 AM"
        android:textSize="16sp"
        android:textColor="#FF4444"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="24dp" />

    <!-- Improved header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="File Upload"
        android:textSize="24sp"
        android:textColor="#212121"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <!-- Enhanced upload area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="256dp"
        android:background="@drawable/upload_area_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_upload"
            app:tint="#212121" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Drag your file here"
            android:textColor="#212121"
            android:fontFamily="sans-serif-medium"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="or"
            android:textColor="#757575"
            android:textSize="16sp" />

        <Button
            android:id="@+id/uploadButton"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#000000"
        android:text="Browse Files"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:textSize="16sp"
        android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Upload list container with improved spacing -->
    <LinearLayout
        android:id="@+id/uploadListContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp" />

    <!-- Enhanced compression section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Need to compress your PDF?"
        android:textSize="16sp"
        android:textColor="#212121"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:layout_marginTop="40dp"/>

    <Button
        android:id="@+id/compressPdfButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#000000"
    android:text="Compress PDF"
    android:textAllCaps="false"
    android:fontFamily="sans-serif-medium"
    android:textSize="16sp"
    android:textColor="#FFFFFF" />
</LinearLayout>
