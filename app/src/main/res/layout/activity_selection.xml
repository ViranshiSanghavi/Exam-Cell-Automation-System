<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Login"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:textColor="@android:color/black"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Student Block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:background="#E0E0E0"
                android:padding="16dp"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/icon_student"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/studentbg"
                    android:contentDescription="Student Icon"/>

                <Button
                    android:id="@+id/button_student"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:text="Student"
                    android:textSize="18sp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#bc1723"
                    android:textColor="@android:color/white"
                    android:padding="12dp"/>
            </LinearLayout>

            <!-- Teacher Block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:background="#E0E0E0"
                android:padding="16dp"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/icon_teacher"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/teacherbg"
                    android:contentDescription="Teacher Icon"/>

                <Button
                    android:id="@+id/button_teacher"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:text="Teacher"
                    android:textSize="18sp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#bc1723"
                    android:textColor="@android:color/white"
                    android:padding="12dp"/>
            </LinearLayout>

            <!-- Admin Block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#E0E0E0"
                android:padding="16dp"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/icon_admin"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/admin_icon"
                    android:contentDescription="Admin Icon"/>

                <Button
                    android:id="@+id/button_admin"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:text="Admin"
                    android:textSize="18sp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#bc1723"
                    android:textColor="@android:color/white"
                    android:padding="12dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
